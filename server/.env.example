GROQ_API_KEY=your-groq-api-key-here
PORT=3000
ADMIN_PASSWORD=your-admin-password-here

# Firebase service account — paste the ENTIRE JSON content as a single line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# CORS — comma-separated allowed origins (localhost is always included)
CORS_ORIGINS=https://ai-opportunity-advisor.web.app,https://ai-opportunity-advisor.firebaseapp.com

# Rate limiting (chat endpoint)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# AI model (change here to swap models without touching code)
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.7
